# ==============================================================================
# NSL Anti-Corruption Reporting Portal - Backend Environment Configuration
# ==============================================================================

# Server Runtime & Port
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Evidence Storage Configuration
# ------------------------------------------------------------------------------
# Set STORAGE_MODE to 'local' for presentation deployment (skips Cloudflare R2)
# Set STORAGE_MODE to 'r2' when you are ready for permanent Cloudflare R2 storage
STORAGE_MODE=local

# Configurable directory for uploaded evidence when STORAGE_MODE=local
# Default: ./uploads
UPLOAD_DIR=./uploads

# ⚠️ IMPORTANT STORAGE NOTICE FOR RENDER:
# Render's default disk is EPHEMERAL. On free and standard Web Services, uploaded
# files stored on local disk will disappear whenever the server restarts, sleeps,
# or is redeployed. For persistent file storage, switch to STORAGE_MODE=r2.

# ------------------------------------------------------------------------------
# 2. Database Connection (Neon PostgreSQL - REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), a valid Neon PostgreSQL connection string
# is strictly required. The backend will fail with HTTP 503 rather than silently
# using an in-memory fallback if Neon is disconnected.
# Example: postgresql://neondb_owner:npg_xyz@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Secure Initial Administrator Account (Production Setup)
# ------------------------------------------------------------------------------
# In production on Render, set this to your desired initial admin email and password.
# The server will automatically hash this password with bcrypt and bootstrap the account once.
INITIAL_ADMIN_EMAIL=admin@nsl.gov.et
INITIAL_ADMIN_PASSWORD=SetAStrongUniquePasswordHere2026!

# ------------------------------------------------------------------------------
# 4. Frontend Application URL (for CORS)
# ------------------------------------------------------------------------------
# Locally: http://localhost:3000
# On Render: set to your Vercel deployment URL (e.g. https://nsl-portal.vercel.app)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. JWT Secret Key (Generate a random 32+ character string in production)
# ------------------------------------------------------------------------------
JWT_SECRET=nsl-anti-corruption-secure-admin-secret-key-2026

# ------------------------------------------------------------------------------
# 6. Optional: Seed demo demonstration records into database on startup
# ------------------------------------------------------------------------------
# Defaults to true in development, false in production
SEED_DEMO_DATA=false

# ------------------------------------------------------------------------------
# 7. Cloudflare R2 Object Storage (OPTIONAL - Only needed when STORAGE_MODE=r2)
# ------------------------------------------------------------------------------
# Leave empty if STORAGE_MODE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
