# Backend API URL (for local dev, default is http://localhost:5000/api)
# In production on Vercel, set this to your Render backend service URL (e.g. https://nsl-portal-api.onrender.com/api)
VITE_API_BASE_URL="http://localhost:5000/api"

# Frontend Public URL (used for QR code generation and canonical links)
# In production on Vercel, set this to your deployed domain (e.g. https://nsl-portal.vercel.app)
VITE_APP_URL="http://localhost:3000"

